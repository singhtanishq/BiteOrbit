# BiteOrbit — environment template. Copy to .env and adjust.
# Values below are the safe local-development defaults used by docker-compose.
# NEVER put real secrets, provider keys or personal data in this file.

# --- Go API ---------------------------------------------------------------
BITEORBIT_ENV=development            # development | test | production
BITEORBIT_HTTP_ADDR=127.0.0.1:8080
BITEORBIT_DATABASE_URL=postgres://biteorbit:biteorbit@127.0.0.1:54329/biteorbit?sslmode=disable
BITEORBIT_REDIS_URL=redis://127.0.0.1:54380/0
BITEORBIT_SESSION_SECRET=change-me-32-bytes-of-random-hex
BITEORBIT_COOKIE_DOMAIN=
BITEORBIT_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003
BITEORBIT_UPLOAD_DIR=./data/uploads

# Local payment adapter is always simulated; no real gateway credentials here.
BITEORBIT_PAYMENT_ADAPTER=mock
# Local SMS/OTP + email adapters are fake/Mailpit and never send real messages.
BITEORBIT_SMS_ADAPTER=fake
BITEORBIT_EMAIL_ADAPTER=mailpit
BITEORBIT_SMTP_ADDR=127.0.0.1:51025
# Maps provider is the deterministic demo simulator unless a real key is supplied.
BITEORBIT_MAPS_ADAPTER=demo

# --- Frontends ------------------------------------------------------------
# Same-origin proxy target for /api/v1/* rewrites in all four apps.
API_ORIGIN=http://127.0.0.1:8080

# --- Docker compose ports (host side) ------------------------------------
# Postgres 54329->5432, Redis 54380->6379, Mailpit 51025->smtp / 51080->ui
