{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"]
    },
    "allowJs": true
  },
  "include": ["next-env.d.ts", "next.config.ts", "src", "vitest.config.ts", ".next/types/**/*.ts"],
  "exclude": ["node_modules", ".next"]
}
